text
repo --name="AppStream" --baseurl=file:///run/install/sources/mount-0000-cdrom/AppStream

%addon com_redhat_kdump --enable --reserve-mb='auto'

%end

# Keyboard layouts
keyboard --xlayouts='us'
# System language
lang en_US.UTF-8

# Use CDROM installation media
cdrom

%packages
@^graphical-server-environment
-gnome-initial-setup
-gnome-tour
%end

network --bootproto=static --ip=192.168.0.5 --netmask=255.255.255.0 --hostname=osdc-provisioner --device=enp1s0

# Run the Setup Agent on first boot
firstboot --disable

xconfig --startxonboot

# Generated using Blivet version 3.6.0
ignoredisk --only-use=vda
# Partition clearing information
clearpart --none --initlabel
# Disk partitioning information
part pv.50 --fstype="lvmpv" --ondisk=vda --size=101375
part /boot --fstype="xfs" --ondisk=vda --size=1024
volgroup rl --pesize=4096 pv.50
logvol / --fstype="xfs" --size=95320 --name=root --vgname=rl
logvol swap --fstype="swap" --size=6051 --name=swap --vgname=rl

# System timezone
timezone America/Denver --utc

