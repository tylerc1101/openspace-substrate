#cloud-config
user: openspace
ssh_authorized_keys:
  - ssh-rsa  root@mgmt-kvm.base-kit.kratos
ntp:
  enabled: true
  ntp_client: chrony
  servers:
    - 192.168.2.1
  config:
    service_name: chronyd
    template: |
        ## template:jinja
        # Cloud-init Chrony Template
        {% if pools -%}# pools{% endif %}
        {% for pool in pools -%}
        pool {{pool}} iburst
        {% endfor %}
        {%- if servers %}# servers
        {% endif %}
        {% for server in servers -%}
        server {{server}} iburst
        {% endfor %}
        {% if peers -%}# peers{% endif %}
        {% for peer in peers -%}
        peer {{peer}}
        {% endfor %}
        {% if allow -%}# allow{% endif %}
        {% for cidr in allow -%}
        allow {{cidr}}
        {% endfor %}
