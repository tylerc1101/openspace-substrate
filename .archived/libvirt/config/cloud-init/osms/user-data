#cloud-config
write_files:
- path: /etc/rancher/rke2/config.yaml.d/60-rancher.yaml
  content: |
    {
    "system-default-registry": ""
    }
- path: /etc/sysctl.d/50-substrate.conf
  content: |
    fs.inotify.max_user_instances=12288
    fs.inotify.max_user_watches=524288
- path: /etc/systemd/system/rke2-server.service.d/override.conf
  content: |
    [Service]
    LimitNOFILE=infinity
- path: /etc/systemd/system/rke2-agent.service.d/override.conf
  content: |
    [Service]
    LimitNOFILE=infinity
- path: /etc/NetworkManager/conf.d/rke2-canal.conf
  content: |
    [keyfile]
    unmanaged-devices=interface-name:cali*;interface-name:flannel*
runcmd:
  - systemctl disable firewalld
  - systemctl stop firewalld
  - sysctl --system
users:
  - name: openspace
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    ssh_authorized_keys:
    - ssh-rsa  root@mgmt-kvm.base-kit.kratos
 
ntp:
  enabled: true
  ntp_client: chrony
  servers:
    - 192.168.2.1
  config:
    service_name: chronyd
    template: |
        ## template:jinja
        # Cloud-init Chrony Template
        {% if pools -%}# pools{% endif %}
        {% for pool in pools -%}
        pool {{pool}} iburst
        {% endfor %}
        {%- if servers %}# servers
        {% endif %}
        {% for server in servers -%}
        server {{server}} iburst
        {% endfor %}
        {% if peers -%}# peers{% endif %}
        {% for peer in peers -%}
        peer {{peer}}
        {% endfor %}
        {% if allow -%}# allow{% endif %}
        {% for cidr in allow -%}
        allow {{cidr}}
        {% endfor %}
