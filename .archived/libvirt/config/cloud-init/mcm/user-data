#cloud-config
package_update: false
write_files:
- path: /etc/hosts
  content: |
    192.168.2.254 rancher.mcm.base-kit.kratos
    192.168.2.254 harbor.mcm.base-kit.kratos
  append: true
- path: /etc/sysctl.d/50-substrate.conf
  content: |
    fs.inotify.max_user_instances=12288
    fs.inotify.max_user_watches=524288
- path: /etc/modules-load.d/kube-virt.conf
  content: |
    ip_vs
    ip_vs_rr
runcmd:
  - systemctl enable '--now' iscsid # Longhorn Requirement
  - systemctl stop firewalld && systemctl disable firewalld
  - update-ca-trust extract
  - systemctl restart chronyd
  - modprobe ip_vs
  - modprobe ip_vs_rr
  - sysctl --system
growpart:
  mode: auto
  devices: ["/"]
users:
  - name: openspace
    groups: sudo
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ssh-rsa  root@mgmt-kvm.base-kit.kratos 
 
ntp:
  enabled: true
  ntp_client: chrony
  servers:
    - 192.168.2.1
  config:
    service_name: chronyd
    template: |
        ## template:jinja
        # Cloud-init Chrony Template
        {% if pools -%}# pools{% endif %}
        {% for pool in pools -%}
        pool {{pool}} iburst
        {% endfor %}
        {%- if servers %}# servers
        {% endif %}
        {% for server in servers -%}
        server {{server}} iburst
        {% endfor %}
        {% if peers -%}# peers{% endif %}
        {% for peer in peers -%}
        peer {{peer}}
        {% endfor %}
        {% if allow -%}# allow{% endif %}
        {% for cidr in allow -%}
        allow {{cidr}}
        {% endfor %}
